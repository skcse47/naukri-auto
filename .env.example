# ---------- Naukri account ----------
NAUKRI_EMAIL=skcse47@gmail.com
NAUKRI_PASSWORD=Holycross02

# ---------- What to search for ----------
# Each search keyword runs as its own Naukri search, sorted by newest first.
SEARCH_KEYWORDS=Node.js Developer,Backend Developer,MERN Stack Developer, GenAI, RAG
# Your skills and languages. A job must mention at least MIN_SKILL_MATCH of these to be applied to.
SKILLS=node.js,javascript,typescript,express,sequelize,sql server,mysql,mongodb,rest api,react,aws, python
MIN_SKILL_MATCH=2
# Skip a job if its title contains any of these (comma separated, case-insensitive)
EXCLUDE_TITLE_WORDS=intern,trainee,php,.net,java developer,sales,manager
# Leave blank for anywhere. Comma separated, e.g. Pune,Mumbai,Remote
LOCATIONS=
# Years of experience (Naukri's experience filter)
EXPERIENCE_YEARS=4
# Only jobs posted within this many days (1 = last 24 hours, best for early applying)
JOB_AGE_DAYS=1

# ---------- Limits ----------
# Naukri caps daily applies (around 50). Keep this low to look human and protect your account.
MAX_APPLIES_PER_RUN=10
# Across all runs in one day (IST). Stay under Naukri's own daily limit.
MAX_APPLIES_PER_DAY=40
# How many search result pages to read per keyword
MAX_PAGES_PER_KEYWORD=2
# Random pause between actions, in milliseconds
MIN_DELAY_MS=4000
MAX_DELAY_MS=9000

# ---------- Browser ----------
HEADLESS=true

# ---------- Email (SMTP) ----------
# For Gmail: turn on 2-step verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=skcse47@gmail.com
SMTP_PASS=qsxl ejwr gpeb brcb
MAIL_FROM=Naukri Bot <skcse47@gmail.com>
MAIL_TO=skcse47@gmail.com
# Send an email even when nothing was applied
MAIL_WHEN_EMPTY=false
